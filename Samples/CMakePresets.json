{
  "version": 6,
  "configurePresets": [
    {
      "name": "samples-ninja",
      "displayName": "Samples (Ninja Multi-Config)",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/../out/build/samples-ninja",
      "environment": {
        "PATH": "$env{ProgramFiles}/Microsoft Visual Studio/2022/Community/Common7/IDE/CommonExtensions/Microsoft/CMake/Ninja;$penv{PATH}"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "samples-ninja",
      "configuration": "Debug"
    },
    {
      "name": "release",
      "configurePreset": "samples-ninja",
      "configuration": "Release"
    }
  ]
}